# Copy to private/.env and fill in. private/ is gitignored.
#   cp .env.example private/.env && chmod 600 private/.env
#
# The FRITZ!Box user needs the "Smart Home" permission, and the box needs
# "Zugriff fuer Anwendungen zulassen" (Heimnetz -> Netzwerk -> Netzwerkeinstellungen).

FRITZ_HOST=fritz.box
FRITZ_USER=example_user
FRITZ_PASSWORD=change-me

# optional
# FRITZ_SCHEME=https
# FRITZ_PORT=443
# FRITZ_VERIFY_TLS=
# FRITZ_CA_FILE=
