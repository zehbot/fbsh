# Copy to private/.env (chmod 600). private/ is gitignored.
# The FRITZ!Box user needs the "Smart Home" right and the box needs
# "Zugriff fuer Anwendungen zulassen" (Heimnetz -> Netzwerk -> Netzwerkeinstellungen).

FRITZ_HOST=fritz.box
FRITZ_USER=example_user
FRITZ_PASSWORD=change-me

# InfluxDB 2.x for "python fbsh.py collect"
# INFLUX_URL=https://influx.example.org:8086
# INFLUX_ORG=example_org
# INFLUX_BUCKET=smarthome
# optional second bucket for power (field "consumption", watts)
# INFLUX_BUCKET_CONSUMPTION=smarthome-power
# INFLUX_TOKEN=***

# optional
# INFLUX_INSECURE=1
# FRITZ_SCHEME=https
# FRITZ_PORT=443
# FRITZ_VERIFY_TLS=1
# FRITZ_CA_FILE=/path/to/box.pem
